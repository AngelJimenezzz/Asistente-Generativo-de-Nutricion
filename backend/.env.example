# Copia este archivo a .env y llena los valores reales (.env nunca se sube a git)

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=nutricion_ia

# development | production
APP_ENV=development

# Orígenes permitidos para CORS, separados por coma. "*" solo para desarrollo local.
CORS_ORIGINS=*

# Together.ai — necesaria para POST /api/plans/generate (motor RAG).
# Consíguela en api.together.ai -> Settings -> API Keys (cuenta de pago por uso).
TOGETHER_API_KEY=
